		"@types/bun": "^1.4.3",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"typescript": "~6",
		"vite": "^8.3.4"
	},
	"dependencies": {
		"@capacitor/android": "^8.5.3",
		"@capacitor/app": "^8.1.2",
		"@capacitor/core": "^8.5.3",
		"@codemirror/commands": "^6.11.1",
