		"@codemirror/theme-one-dark": "^6.1.3",
		"@codemirror/view": "^6.43.14",
		"@electric-sql/pglite": "^0.5.9",
		"@fontsource-variable/inter": "^5.3.0",
		"codemirror": "^6.0.2",
		"marked": "^18.1.1",
		"mingo": "^7.2.5",
