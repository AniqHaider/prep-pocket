{
	"name": "prep-pocket",
	"private": true,
	"version": "1.7.0",
	"type": "module",
	"scripts": {
		"dev": "vite --host --port 5180",
		"build": "vite build",
		"preview": "vite preview --port 5180",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"verify": "bun scripts/verify-dojo.ts && bun scripts/verify-drills.ts",
		"pyodide:copy": "bun scripts/copy-pyodide.ts",
		"android:sync": "bun run build && cap sync android",
